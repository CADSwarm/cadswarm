# CadSwarm environment. Never commit real keys. On a normal install these live in the OS
# keychain, not in a file.
#
# Put the filled-in copy wherever your commands run:
#   - cadswarm.env next to the checkout(s), e.g. Projects\cadswarm.env, shared by every worktree
#   - or .env inside one checkout (git-ignored)
#
# Load it for one command in PowerShell:
#   powershell -File scripts\with-env.ps1 python -m pytest -q
#   powershell -File scripts\with-env.ps1 host\target\release\cadswarm-host.exe --data .\team run
# or set the same names yourself (`$env:ANTHROPIC_API_KEY = "..."`).

# --- Bring-your-own AI helpers --------------------------------------------------------
# Not needed when people sign in with `claude`, `codex` or `opencode` themselves (the default).
# Set one only for API-key auth on a machine with no interactive login.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Publishing a release (optional, local) -------------------------------------------
# The release workflow uses GitHub's own token. This is only for `gh release create` on a
# headless machine.
# GH_TOKEN=

# --- SpacetimeDB is not an API key ----------------------------------------------------
# Maincloud publishing uses the CLI's stored login: run `spacetime login` once.
# CADSWARM_HOST_TOKEN overrides that token for a headless host (development only).

# --- Developer overrides (not secrets) -------------------------------------------------
# CADSWARM_FREECAD_PYTHON=C:\Program Files\FreeCAD 1.1\bin\python.exe
# CADSWARM_RELEASE_BASE=file:///C:/path/to/dist
# CADSWARM_HOST_BIN=
# SPACETIME_BIN=
# CADSWARM_MODULE_WASM=
# CADSWARM_DEPS=
# CADSWARM_PROJECT=
# CADSWARM_OPENCODE=
# CADSWARM_BOARDS=
# CADSWARM_CCX=
# CADSWARM_PROJECT_LIMIT_GB=
# PYTHON=
