         if family == "AF_UNIX" and os.path.exists(addr):
-            try:  # forward() failed to reach it, so it's left over from a crashed run
-                os.unlink(addr)
-            except OSError:
+            # Probe the filesystem socket before removing it. A failed authenticated handoff can
+            # also be a temporary connection problem with a live server; unlinking its path would
+            # strand that server and let a second CADSwarm start on the same profile.
+            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            try:
+                probe.settimeout(0.25)
+                probe.connect(addr)
+            except ConnectionRefusedError:  # stale path left by a crashed process
+                try:
+                    os.unlink(addr)
+                except OSError:
+                    return False
+            except FileNotFoundError:  # another process already removed the stale path
+                pass
+            except OSError:
                 return False
+            else:  # a live listener owns the channel
+                return False
+            finally:
+                probe.close()
+        try:
+            self._listener = Listener(addr, family, authkey=key)
+        except OSError:
                 return False
-        try:
-            self._listener = Listener(addr, family, authkey=key)
-        except OSError:
-            return False  # another instance owns the channel; run without hand-offs
         threading.Thread(target=self._serve, name="cadswarm-instance", daemon=True).start()
         return True
